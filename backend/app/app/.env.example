# ============================================================
# PJMOL – Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com credenciais reais.
# ============================================================

ENVIRONMENT=development          # development | production
TZ=America/Sao_Paulo
DOMAIN=localhost                 # localhost em dev; pjmol.com.br em prod

SECRET_KEY=troque-por-uma-chave-segura
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

DB_FILE=/caminho/absoluto/para/database.db

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

STORAGE_ROOT=/caminho/absoluto/para/storage
STORAGE_EXTRATO_SUBDIR=extratos
STORAGE_ASSINATURAS_SUBDIR=assinaturas

# ZapSign
ZAPSIGN_SANDBOX=true
ZAPSIGN_API_KEY_DEFAULT=
ZAPSIGN_WEBHOOK_SECRET=

# E-mail (SMTP/IMAP)
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

IMAP_SERVER=imap.hostinger.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_STARTTLS=false
SMTP_SSL=true
MAIL_FROM=
MAIL_FROM_NAME="PJMOL – Alertas"
MAIL_SAVE_SENT=true

IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SENT_FOLDER=sent

# LibreOffice (geração de PDF)
SOFFICE_PATH=/usr/bin/soffice    # macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice

# Google (opcional)
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

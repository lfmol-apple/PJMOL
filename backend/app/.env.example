# PJMOL - Backend Environment Variables
# Copie este arquivo para .env e preencha os valores

# Ambiente
ENVIRONMENT=local
TZ=America/Sao_Paulo
DOMAIN=localhost

# Segurança
SECRET_KEY=troque-por-uma-chave-segura
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Banco de Dados
DB_FILE=./database.db

# CORS e URLs
CORS_ALLOW_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Storage
STORAGE_ROOT=./storage
STORAGE_EXTRATO_SUBDIR=extratos
STORAGE_ASSINATURAS_SUBDIR=assinaturas

# ZapSign
ZAPSIGN_SANDBOX=true
ZAPSIGN_WEBHOOK_SECRET=

# LibreOffice
SOFFICE_PATH=/usr/bin/soffice

# Google APIs
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Email SMTP (saída)
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=email@exemplo.com.br
SMTP_PASSWORD=
MAIL_FROM=email@exemplo.com.br
MAIL_FROM_NAME=PJMOL

# Email IMAP (entrada)
MAIL_SAVE_SENT=true
IMAP_HOST=imap.exemplo.com.br
IMAP_PORT=993
IMAP_USERNAME=email@exemplo.com.br
IMAP_PASSWORD=
IMAP_SENT_FOLDER=Sent

# Push Notifications (VAPID)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:email@exemplo.com.br

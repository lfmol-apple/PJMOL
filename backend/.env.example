# =============================================================
# PJMOL — Backend — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real no repositório.
# =============================================================

# ─── Banco de dados ─────────────────────────────────────────
# Produção usa SQLite no caminho configurado pelo servidor.
# Local: deixe sem definir para usar o padrão (app/app.db em tmp).
# Nunca aponte para o banco real de produção em ambiente local.
DATABASE_URL=sqlite:////tmp/pjmol_local_dev.db

# ─── URL pública do backend ──────────────────────────────────
# Usada para gerar links em documentos e assinaturas ZapSign.
# Em ambiente local, use localhost com a porta do uvicorn.
PUBLIC_BASE_URL=http://localhost:8000

# ─── CORS ────────────────────────────────────────────────────
# Origens permitidas para chamadas ao backend.
# Separe múltiplas origens com vírgula.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ─── Storage ─────────────────────────────────────────────────
# Caminho onde documentos e uploads são gravados.
# Local: use um caminho temporário seguro — NUNCA o storage de produção.
STORAGE_ROOT=/tmp/pjmol_storage_local

# ─── E-mail (SMTP) ───────────────────────────────────────────
# Deixar vazio desativa o envio de e-mails localmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=PJMOL Local
SMTP_STARTTLS=true
SMTP_SSL=false

# IMAP (para salvar e-mails enviados) — opcional
MAIL_SAVE_SENT=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SENT_FOLDER=

# ─── ZapSign (assinaturas digitais) ──────────────────────────
# NUNCA use o token de produção em ambiente local.
# Use o token sandbox da ZapSign para testes.
ZAPSIGN_SANDBOX=true

# ─── Google Drive (upload de documentos) ─────────────────────
# Desligado por padrão em ambiente local.
DRIVE_UPLOAD=off
DRIVE_STRICT=off
PASTA_DRIVE_ID=

# ─── LibreOffice (geração de documentos) ─────────────────────
# Caminho do soffice — necessário para gerar PDFs.
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Linux: /usr/bin/soffice
SOFFICE_PATH=

# ─── Google AI / Gemini (extração ML) ────────────────────────
# Deixar vazio desliga o Gemini (o sistema usa extração local).
GOOGLE_API_KEY=

# ─── Outros ──────────────────────────────────────────────────
# URL de descadastramento de e-mail (opt-out)
LIST_UNSUB_URL=
LIST_UNSUB_MAILTO=

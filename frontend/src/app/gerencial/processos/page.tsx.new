function MobileProcessCard({ it, compact=false, onMarkSignedExternal }: { it: any; compact?: boolean; onMarkSignedExternal?: (p:any)=>void }) {
  // ... (rest of the component code) ...
  <button 
    onClick={() => onMarkSignedExternal && onMarkSignedExternal(it)} 
    className={`text-[12px] ${it.status === 'Assinado (fora)' ? 'text-slate-500' : 'text-emerald-700'} underline`}
  >
    {it.status === 'Assinado (fora)' ? 'Remover Assinado Fora' : 'Assinado Fora'}
  </button>
  // ... (rest of the component code) ...
}

export default function GerencialProcessosPage() {
  // ... (previous state and code) ...

  const toggleSignedExternal = async (proc: Processo) => {
    const id = Number(proc?.id);
    if (!id) return alert('ID inválido');
    
    const isCurrentlySigned = proc.status === 'Assinado (fora)';
    const action = isCurrentlySigned ? 'unmark' : 'mark';
    
    if (!confirm(`${isCurrentlySigned ? 'Remover marca' : 'Marcar'} processo #${id} como assinado fora da plataforma?`)) return;
    
    try {
      const headers = buildAuthHeaders({ 'Content-Type': 'application/json' });
      const endpoint = `${API_BASE}/uploads/${action}_signed_external/${id}`;
      
      const res = await fetch(endpoint, {
        method: 'POST',
        headers,
        credentials: 'include'
      });
      
      if (!res.ok) throw new Error(await res.text());
      await fetchData();
      
      alert(`Processo ${isCurrentlySigned ? 'desmarcado' : 'marcado'} como Assinado (fora).`);
    } catch (e: any) {
      console.error(e);
      alert(e?.message || `Erro ao ${isCurrentlySigned ? 'desmarcar' : 'marcar'} como assinado`);
    }
  };

  // ... (rest of the component code, replacing markSignedExternal with toggleSignedExternal) ...
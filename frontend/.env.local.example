# =============================================================
# PJMOL — Frontend — Variáveis de ambiente local
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositório.
# =============================================================

# ─── URL do backend ──────────────────────────────────────────
# Em ambiente local, aponta para o uvicorn rodando na porta 8000.
# NUNCA aponte para o backend de produção em testes locais.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── URL pública do frontend ─────────────────────────────────
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ─── Controle de acesso (opcional) ───────────────────────────
# Lista de usuários com permissão de admin (separados por vírgula).
# Se vazio, usa a lista hardcoded no código.
NEXT_PUBLIC_ADMIN_USERS=

# Lista de usuários com permissão de gerente (separados por vírgula).
NEXT_PUBLIC_GERENTE_USERS=
